[Desktop Entry]
Type=Application
Version=1.0
Name=LumaGlyph
GenericName=ASCII Art & Video Workstation
Comment=High-throughput 95-character color ASCII art and streaming video workstation
Exec=lumaglyph %f
TryExec=lumaglyph
Icon=lumaglyph
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;AudioVideo;Video;
MimeType=image/png;image/jpeg;image/webp;image/gif;image/bmp;video/mp4;video/webm;video/x-matroska;video/quicktime;
StartupNotify=true
StartupWMClass=LumaGlyph
